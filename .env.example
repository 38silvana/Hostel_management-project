# ==============================================================================
# Shanthibavanam Hostel Management - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# DO NOT commit .env.local to Git.

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous / Publishable Key (Client & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# 3. Supabase Service Role Key (SERVER ONLY - Never prefix with NEXT_PUBLIC_)
# Used strictly inside server Route Handlers for admin actions, student approval, etc.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 4. Optional API Base URL (Defaults to empty string for standalone Next.js routes)
NEXT_PUBLIC_API_BASE_URL=

